EDITTA_DATABASE_URL=postgresql+asyncpg://editta:editta@localhost:5432/editta
# Worker queue + retention sweep need the BYPASSRLS role from migration 0003 (row-level
# security is forced on the app role, which would see no rows). Required outside local
# dev, where the compose superuser bypasses RLS anyway. The worker refuses to start
# with a role that is subject to RLS.
# EDITTA_WORKER_DATABASE_URL=postgresql+asyncpg://editta_worker:CHANGE_ME@localhost:5432/editta
# Password migration 0003 gives editta_worker (needed when running `alembic upgrade`).
EDITTA_WORKER_DB_PASSWORD=change-me
EDITTA_ANTHROPIC_API_KEY=sk-ant-...
EDITTA_S3_ENDPOINT_URL=http://localhost:9000
EDITTA_S3_BUCKET=editta-dev
EDITTA_S3_ACCESS_KEY=editta
EDITTA_S3_SECRET_KEY=editta123
EDITTA_SESSION_SECRET=change-me-to-a-random-64-char-value
EDITTA_ENVIRONMENT=development
